<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/principal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="8dp"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textoPantalla"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:fontFamily="sans-serif-light"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:text="0"
        android:textColor="@color/pantalla_texto"
        android:textSize="48sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/boton7" style="@style/BotonNumero" android:text="7" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton8" style="@style/BotonNumero" android:text="8" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton9" style="@style/BotonNumero" android:text="9" />
        <com.google.android.material.button.MaterialButton android:id="@+id/botonDividir" style="@style/BotonOperador" android:text="÷" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/boton4" style="@style/BotonNumero" android:text="4" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton5" style="@style/BotonNumero" android:text="5" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton6" style="@style/BotonNumero" android:text="6" />
        <com.google.android.material.button.MaterialButton android:id="@+id/botonMultiplicar" style="@style/BotonOperador" android:text="×" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/boton1" style="@style/BotonNumero" android:text="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton2" style="@style/BotonNumero" android:text="2" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton3" style="@style/BotonNumero" android:text="3" />
        <com.google.android.material.button.MaterialButton android:id="@+id/botonRestar" style="@style/BotonOperador" android:text="-" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/botonBorrar" style="@style/BotonBorrar" android:text="C" />
        <com.google.android.material.button.MaterialButton android:id="@+id/boton0" style="@style/BotonNumero" android:text="0" />
        <com.google.android.material.button.MaterialButton android:id="@+id/botonDecimal" style="@style/BotonNumero" android:text="." />
        <com.google.android.material.button.MaterialButton android:id="@+id/botonSumar" style="@style/BotonOperador" android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton android:id="@+id/botonIgual" style="@style/BotonIgual" android:text="=" />
    </LinearLayout>

</LinearLayout>